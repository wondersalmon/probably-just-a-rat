{
  "name": "probably-just-a-rat",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Client-local last-seen token memory for Foundry VTT 14.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wondersalmon/probably-just-a-rat.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts tools tests test-ui playwright.config.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node tools/test-suite.mjs",
    "test:coverage": "node tools/test-suite.mjs --coverage",
    "test:ui": "playwright test",
    "validate": "node tools/validate.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate",
    "check:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run validate",
    "benchmark": "node tools/benchmark.mjs",
    "build": "node tools/build.mjs",
    "release:verify": "node dev/release-tools/bin/package.mjs --verify",
    "release:github": "node dev/release-tools/bin/publish-github.mjs",
    "test:local": "node --test dev/release-tools/tests/release-script.test.mjs",
    "release:setup": "node tools/files.mjs --setup-release-tools",
    "release:build": "node dev/release-tools/bin/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "pixi.js": "7.4.3",
    "archiver": "8.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "foundryRelease": {
    "toolkitRepository": "wondersalmon/foundry-release-tools",
    "revision": "9ad17b969cb2c6ce51a92b036f36b3be84fa8dc5",
    "sourceReleaseUrls": false,
    "defaultReleaseBuild": false,
    "benchmark": {
      "executable": "npm.cmd",
      "arguments": [
        "run",
        "benchmark"
      ]
    },
    "notesHeading": true,
    "packageFiles": {
      "module": "tools/validate.mjs",
      "export": "validate"
    }
  }
}
